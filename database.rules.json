{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['uid', 'email', 'username', 'displayName'])"
      }
    },

    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },

    "posts": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && (!data.exists() || data.child('authorId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['authorId', 'imageUrl', 'createdAt'])"
      }
    },

    "likes": {
      ".read": "auth != null",
      "$postId": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
        }
      }
    },

    "comments": {
      ".read": "auth != null",
      "$postId": {
        "$commentId": {
          ".write": "auth != null && (!data.exists() || data.child('authorId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
        }
      }
    },

    "savedPosts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notifId": {
          ".write": "auth != null"
        }
      }
    },

    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$reportId": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "adminAuditLogs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$logId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    }
  }
}
